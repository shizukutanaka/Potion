{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Potion.Service.Controllers": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} [{SourceContext}] [{ThreadId}] [{ProcessId}] [{MachineName}] [{ServiceVersion}]{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "%ProgramData%\\Potion\\logs\\dev-otedama-.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} [{SourceContext}] [{ThreadId}] [{ProcessId}] [{MachineName}] [{ServiceVersion}] [{Properties:j}]{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "buffered": false,
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "ServiceVersion": "2.0.0-dev",
      "Environment": "Development"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001",
        "Certificate": {
          "Path": "",
          "Password": ""
        }
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 10,
      "MaxConcurrentUpgradedConnections": 5,
      "MaxRequestBodySize": 5242880,
      "MinRequestBodyDataRate": {
        "BytesPerSecond": 100,
        "GracePeriod": "00:00:30"
      }
    }
  },
  "RemediationPolicy": {
    "MaxConcurrency": 1,
    "SchedulerIntervalSeconds": 60,
    "ScheduleJitterSeconds": 10
  },
  "CorrelationAnalysis": {
    "Enabled": true,
    "AnalysisIntervalMinutes": 1,
    "MaxHistorySize": 1000,
    "EnableAdvancedAlgorithms": true,
    "StatisticalSignificanceLevel": 0.1,
    "MinSampleSize": 5,
    "MaxSampleSize": 100,
    "EnableAnomalyDetection": true,
    "AnomalyThreshold": 0.5,
    "EnableParallelProcessing": false,
    "MaxDegreeOfParallelism": 2
  },
  "MachineLearning": {
    "Enabled": false,
    "AnomalyDetectionSensitivity": 0.8,
    "ModelValidationEnabled": false,
    "FeatureEngineeringEnabled": false,
    "AutoML": false
  },
  "Security": {
    "Enabled": false,
    "AuditEnabled": false,
    "LogSecurityEvents": false,
    "AlertOnCriticalIssues": false,
    "SecurityScoreThreshold": 50
  },
  "Metrics": {
    "Enabled": true,
    "CollectionIntervalSeconds": 30,
    "ExportIntervalMinutes": 1
  },
  "FeatureFlags": {
    "AdvancedCorrelationAnalysis": false,
    "MachineLearningIntegration": false,
    "RealTimeMonitoring": true,
    "PredictiveMaintenance": false,
    "AutoScaling": false,
    "MultiTenant": false,
    "CloudIntegration": false,
    "APIGateway": false
  }
}
