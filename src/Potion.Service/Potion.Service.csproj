<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Potion.Service</RootNamespace>
    <AssemblyName>Potion.Service</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <UseWindowsService>true</UseWindowsService>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- セキュリティとパフォーマンスの最適化 -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- PublishTrimmed は JsonSerializer のリフレクションベース解決を既定で無効化する。
         AOT ではなくトリムのみのためリフレクションを再有効化し、Minimal API / SecureLogService 等の動的シリアライズを機能させる -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 高度な最適化 -->
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Native AOT対応 (Phase 2で有効化予定) -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- セキュリティ設定 -->
    <EnablePreviewFeatures>false</EnablePreviewFeatures>
    <WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- async-without-await wrappers are pervasive (816 sites); suppressing preserves exception semantics -->
    <NoWarn>CS1998</NoWarn>
    <!-- パッケージ検証 -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- バージョン情報 -->
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0-dev</InformationalVersion>
  </PropertyGroup>

  <!-- 条件付きコンパイル設定 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <PathMap>$(MSBuildProjectDirectory)=/</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />

    <!-- OpenTelemetry - Observability (Phase 1) -->
    <PackageReference Include="OpenTelemetry" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.19.0-rc.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <!-- Prometheus.AspNetCore is published by upstream as prerelease-only; no stable exists -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.19.1-beta.1" />

    <!-- Polly - Resilience Patterns (Phase 1) -->
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Polly.RateLimiting" Version="8.8.0" />

    <!-- ML.NET packages removed: no code references Microsoft.ML (anomaly detection is statistical, not ML.NET-based). Re-add when a real ML.NET pipeline lands. -->

    <!-- Core Infrastructure -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.4" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />

  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ソースリンク設定 -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- 静的解析設定 -->
  <PropertyGroup>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- NuGetパッケージ設定 -->
  <PropertyGroup>
    <PackageId>Potion.Service</PackageId>
    <Description>Production-grade Windows system automation service with autonomous remediation, monitoring, and security controls</Description>
    <PackageTags>windows-service;self-healing;remediation;monitoring;system-automation;security</PackageTags>
    <PackageProjectUrl>https://github.com/irosa/Potion</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/irosa/Potion.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Potion Contributors</Authors>
    <Company>Open Source</Company>
  </PropertyGroup>

</Project>
