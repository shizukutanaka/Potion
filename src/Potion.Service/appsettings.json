{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} [{SourceContext}] [{ThreadId}] [{ProcessId}] [{MachineName}] [{ServiceVersion}]{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/Potion/logs/potion-.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} [{SourceContext}] [{ThreadId}] [{ProcessId}] [{MachineName}] [{ServiceVersion}] [{Properties:j}]{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 45,
          "buffered": true,
          "restrictedToMinimumLevel": "Debug"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/Potion/logs/potion-errors-.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} [{SourceContext}] [{ThreadId}] [{ProcessId}] [{MachineName}] [{ServiceVersion}] [{Properties:j}]{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "buffered": true,
          "restrictedToMinimumLevel": "Error"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ServiceVersion": "1.0.0"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 10,
      "MaxRequestBodySize": 1048576,
      "MinRequestBodyDataRate": {
        "BytesPerSecond": 100,
        "GracePeriod": "00:00:10"
      },
      "MinResponseDataRate": {
        "BytesPerSecond": 100,
        "GracePeriod": "00:00:10"
      }
    }
  },
  "RemediationPolicy": {
    "MaxConcurrency": 4,
    "SchedulerIntervalSeconds": 300,
    "ScheduleJitterSeconds": 60,
    "CommandAllowlist": [
      "sfc.exe",
      "dism.exe",
      "cleanmgr.exe",
      "chkdsk.exe",
      "wevtutil.exe",
      "powercfg.exe",
      "net.exe",
      "netsh.exe",
      "ipconfig.exe",
      "systeminfo.exe",
      "ngen.exe"
    ],
    "MaintenanceWindows": [
      {
        "Tag": "overnight",
        "StartTime": "22:00",
        "EndTime": "06:00",
        "DaysOfWeek": [
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday"
        ]
      },
      {
        "Tag": "business_hours",
        "StartTime": "08:00",
        "EndTime": "18:00",
        "DaysOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ]
      }
    ],
    "Tasks": [
      {
        "Name": "sfc_integrity_scan",
        "DisplayName": "System File Checker Integrity Scan",
        "Command": "sfc.exe",
        "Arguments": "/scannow",
        "RunEveryMinutes": 10080,
        "TimeoutSeconds": 1800,
        "RequiresElevation": true,
        "Enabled": true,
        "MaxRetries": 1,
        "RetryBackoffSeconds": 900,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "overnight",
        "AllowedExitCodes": [
          0
        ]
      },
      {
        "Name": "dism_health_restore",
        "DisplayName": "DISM Health Restore",
        "Command": "dism.exe",
        "Arguments": "/Online /Cleanup-Image /RestoreHealth",
        "RunEveryMinutes": 10080,
        "TimeoutSeconds": 3600,
        "RequiresElevation": true,
        "Enabled": true,
        "MaxRetries": 1,
        "RetryBackoffSeconds": 1800,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "overnight",
        "AllowedExitCodes": [
          0
        ]
      },
      {
        "Name": "disk_cleanup",
        "DisplayName": "Disk Cleanup",
        "Command": "cleanmgr.exe",
        "Arguments": "/sagerun:1",
        "RunEveryMinutes": 1440,
        "TimeoutSeconds": 3600,
        "RequiresElevation": true,
        "Enabled": true,
        "MaxRetries": 1,
        "RetryBackoffSeconds": 900,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "business_hours",
        "AllowedExitCodes": [
          0
        ]
      },
      {
        "Name": "dotnet_optimization",
        "DisplayName": ".NET Runtime Optimization",
        "Command": "ngen.exe",
        "Arguments": "update /force",
        "RunEveryMinutes": 10080,
        "TimeoutSeconds": 3600,
        "RequiresElevation": true,
        "Enabled": true,
        "MaxRetries": 1,
        "RetryBackoffSeconds": 1800,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "overnight",
        "AllowedExitCodes": [
          0
        ]
      }
    ]
  },
  "FeatureFlags": {
    "RepairExecutionEnabled": false
  },
  "EventCorrelation": {
    "Enabled": true
  },
  "Compliance": {
    "Enabled": true
  }
}