{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Potion": {
    "ServiceName": "Potion.Service",
    "Version": "1.0.0",
    "Environment": "Production",
    "MainCycleIntervalSeconds": 60,
    "MaxConcurrentTasks": 10,
    "HealthCheckIntervalSeconds": 30,
    "MaxLogFileAgeDays": 7,
    "MaxTempFileAgeHours": 24
  }
}
