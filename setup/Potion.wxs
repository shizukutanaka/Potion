<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Potion Self-Healing Service" Manufacturer="Potion Corp" Version="1.0.0" UpgradeCode="12345678-1234-1234-1234-123456789012">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Potion is already installed." />

    <Feature Id="Main" Title="Potion Self-Healing Service" Description="Windows system self-healing service" Level="1" AllowAdvertise="no" Display="expand">

      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="ConfigComponents" />

    </Feature>

    <InstallExecuteSequence>
      <Custom Action="InstallService" After="InstallFiles" />
      <Custom Action="StartService" After="InstallService" />
    </InstallExecuteSequence>

    <InstallUISequence>
      <Show Dialog="WelcomeDlg" Before="ProgressDlg" />
      <Show Dialog="LicenseAgreementDlg" After="WelcomeDlg" />
      <Show Dialog="InstallDirDlg" After="LicenseAgreementDlg" />
      <Show Dialog="ProgressDlg" After="InstallDirDlg" />
      <Show Dialog="ExitDlg" After="ProgressDlg" />
    </InstallUISequence>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Potion Management Console" />

    <UIRef Id="WixUI_InstallDir" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />

    <CustomAction Id="InstallService" BinaryKey="ServiceInstaller" DllEntry="InstallService" Execute="deferred" Impersonate="no" />
    <CustomAction Id="StartService" BinaryKey="ServiceInstaller" DllEntry="StartService" Execute="deferred" Impersonate="no" />

    <Binary Id="ServiceInstaller" SourceFile="Potion.Service.Installer.dll" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Potion">
          <Directory Id="ServiceDir" Name="Service" />
        </Directory>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="PotionAppData" Name="Potion">
          <Directory Id="LogsDir" Name="logs" />
          <Directory Id="StateDir" Name="state" />
          <Directory Id="TelemetryDir" Name="telemetry" />
        </Directory>
      </Directory>
    </Directory>

    <ComponentGroup Id="ServiceComponents" Directory="ServiceDir">
      <Component>
        <File Source="src\Potion.Service\bin\Release\net8.0\win-x64\publish\Potion.Service.exe" />
        <ServiceInstall
          Id="PotionService"
          Name="Potion Self-Healing Service"
          DisplayName="Potion Self-Healing Service"
          Description="Windows system automatic diagnostics and remediation service"
          Start="auto"
          ErrorControl="normal"
          Type="ownProcess" />
        <ServiceControl
          Id="StartServiceControl"
          Name="Potion Self-Healing Service"
          Start="install"
          Stop="both"
          Remove="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConfigComponents" Directory="ServiceDir">
      <Component>
        <File Source="src\Potion.Service\appsettings.json" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
