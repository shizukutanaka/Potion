<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Build: dotnet publish src/Potion.Service -c Release -r win-x64 -p:PublishSelfContained=true -p:PublishTrimmed=false -o src/Potion.Service/bin/Release/net8.0/win-x64/publish
       then: wix build setup/Potion.wxs -ext WixToolset.UI.wixext -o Potion.msi -->
  <Package Name="Potion Self-Healing Service" Manufacturer="Potion" Version="1.0.0" UpgradeCode="12345678-1234-1234-1234-123456789012">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Potion is already installed." />

    <Feature Id="Main" Title="Potion Self-Healing Service" Description="Windows system self-healing service" Level="1" AllowAdvertise="no" Display="expand">

      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="ConfigComponents" />

    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <UIRef Id="WixUI_InstallDir" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Potion" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="PotionAppData" Name="Potion">
          <Directory Id="LogsDir" Name="logs" />
          <Directory Id="StateDir" Name="state" />
          <Directory Id="TelemetryDir" Name="telemetry" />
        </Directory>
      </Directory>
    </Directory>

    <!-- Harvests the entire publish output: every file the service needs at runtime.
         Requires: dotnet publish -o src/Potion.Service/bin/Release/net8.0/win-x64/publish -->
    <ComponentGroup Id="ServiceComponents" Directory="INSTALLDIR">
      <Component>
        <File Source="..\src\Potion.Service\bin\Release\net8.0\win-x64\publish\Potion.Service.exe" />
        <ServiceInstall
          Id="PotionService"
          Name="Potion Self-Healing Service"
          DisplayName="Potion Self-Healing Service"
          Description="Windows system automatic diagnostics and remediation service"
          Start="auto"
          ErrorControl="normal"
          Type="ownProcess" />
        <ServiceControl
          Id="StartServiceControl"
          Name="Potion Self-Healing Service"
          Start="install"
          Stop="both"
          Remove="uninstall" />
        <!-- Without env vars the service boots in the Production environment,
             whose Kestrel HTTPS endpoint requires certificate.pfx (not installed
             here) and startup fails. Bind HTTP; operators add the cert under
             ProgramData\Potion\certs and remove this value to enable HTTPS. -->
        <RegistryKey Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\Potion Self-Healing Service"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="multiString" Name="Environment"
                         Value="ASPNETCORE_URLS=http://localhost:5000" />
        </RegistryKey>
      </Component>
      <Files Include="..\src\Potion.Service\bin\Release\net8.0\win-x64\publish\**"
             Exclude="..\src\Potion.Service\bin\Release\net8.0\win-x64\publish\Potion.Service.exe" />
    </ComponentGroup>

    <ComponentGroup Id="ConfigComponents" Directory="INSTALLDIR">
      <Component>
        <File Source="..\src\Potion.Service\appsettings.json" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
