<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>annotations</Nullable>
    <!-- 製品APIはWindows専用のため CA1416 プラットフォーム警告と async テストの CS1998 は想定内 -->
    <NoWarn>CA1416;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Potion.Service\Potion.Service.csproj" />
    <!-- Explicit copy: tests bind against the service's real config. Relying on
         transitive ProjectReference content flow races parallel builds and
         intermittently left appsettings.json missing from the test output. -->
    <None Include="..\..\src\Potion.Service\appsettings.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.json" />
    <None Include="..\..\src\Potion.Service\appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.Development.json" />
  </ItemGroup>

</Project>
