{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "RemediationPolicy": {
    "MaxConcurrency": 1,
    "SchedulerIntervalSeconds": 1800,
    "ScheduleJitterSeconds": 300,
    "CommandAllowlist": [
      "sfc.exe",
      "dism.exe",
      "cleanmgr.exe",
      "chkdsk.exe",
      "defrag.exe",
      "powercfg.exe",
      "schtasks.exe"
    ],
    "MaintenanceWindows": [
      {
        "Tag": "night",
        "StartTime": "01:00",
        "EndTime": "06:00",
        "DaysOfWeek": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
      },
      {
        "Tag": "lunch",
        "StartTime": "12:00",
        "EndTime": "13:00",
        "DaysOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
      }
    ],
    "Tasks": [
      {
        "Name": "sfc_scan",
        "DisplayName": "System File Checker",
        "Command": "sfc.exe",
        "Arguments": "/scannow",
        "RunEveryMinutes": 10080,
        "TimeoutSeconds": 7200,
        "RequiresElevation": true,
        "Enabled": true,
        "MaxRetries": 2,
        "RetryBackoffSeconds": 1800,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "night",
        "AllowedExitCodes": [0]
      },
      {
        "Name": "dism_health",
        "DisplayName": "DISM Health Check",
        "Command": "dism.exe",
        "Arguments": "/Online /Cleanup-Image /RestoreHealth",
        "RunEveryMinutes": 10080,
        "TimeoutSeconds": 14400,
        "RequiresElevation": true,
        "Enabled": true,
        "MaxRetries": 1,
        "RetryBackoffSeconds": 3600,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "night",
        "AllowedExitCodes": [0]
      },
      {
        "Name": "disk_cleanup",
        "DisplayName": "Disk Cleanup",
        "Command": "cleanmgr.exe",
        "Arguments": "/sagerun:1",
        "RunEveryMinutes": 1440,
        "TimeoutSeconds": 3600,
        "RequiresElevation": true,
        "Enabled": true,
        "MaxRetries": 1,
        "RetryBackoffSeconds": 600,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "lunch",
        "AllowedExitCodes": [0]
      },
      {
        "Name": "disk_defrag",
        "DisplayName": "Disk Defragmentation",
        "Command": "defrag.exe",
        "Arguments": "C: /O /H /U",
        "RunEveryMinutes": 10080,
        "TimeoutSeconds": 14400,
        "RequiresElevation": true,
        "Enabled": false,
        "MaxRetries": 0,
        "RetryBackoffSeconds": 1800,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "night",
        "AllowedExitCodes": [0]
      },
      {
        "Name": "power_health",
        "DisplayName": "Power Health Report",
        "Command": "powercfg.exe",
        "Arguments": "/energy /output %ProgramData%\\Potion\\reports\\energy-report.html",
        "RunEveryMinutes": 10080,
        "TimeoutSeconds": 300,
        "RequiresElevation": true,
        "Enabled": false,
        "MaxRetries": 0,
        "RetryBackoffSeconds": 600,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "night",
        "AllowedExitCodes": [0]
      },
      {
        "Name": "temp_cleanup",
        "DisplayName": "Temporary Files Cleanup",
        "Command": "schtasks.exe",
        "Arguments": "/Run /TN \"Microsoft\\Windows\\DiskCleanup\\SilentCleanup\"",
        "RunEveryMinutes": 1440,
        "TimeoutSeconds": 1800,
        "RequiresElevation": false,
        "Enabled": true,
        "MaxRetries": 1,
        "RetryBackoffSeconds": 300,
        "StopOnFailure": false,
        "MaintenanceWindowTag": "lunch",
        "AllowedExitCodes": [0]
      }
    ]
  },
  "TelemetryRetention": {
    "Enabled": true,
    "RetentionDays": 90,
    "CleanupIntervalHours": 24,
    "MaxDeletionsPerSweep": 1000
  },
  "RemoteManagement": {
    "Enabled": false,
    "ServerEndpoint": "",
    "ApiKey": "",
    "MachineId": "",
    "HeartbeatInterval": "00:05:00",
    "LogSyncInterval": "01:00:00"
  },
  "SecurityAudit": {
    "Enabled": true,
    "AuditIntervalHours": 24,
    "LogSecurityEvents": true,
    "AlertOnCriticalIssues": true,
    "MaxLogRetentionDays": 30
  }
}
