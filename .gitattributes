# Line-ending policy: this is a Windows-targeted product with cross-platform
# dev (macOS/Linux build+test) — pin the endings each file type requires.
* text=auto

# POSIX shells must stay LF or they break with `$'\r': command not found`
# even when checked out on Windows (Git Bash, WSL, docker build contexts).
*.sh    text eol=lf
*.bash  text eol=lf

# Batch files require CRLF — LF-only checkouts break goto/label parsing.
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Windows-native formats; keep CRLF by convention.
*.ps1   text eol=crlf
*.wxs   text eol=crlf

# Binaries — never normalize.
*.png   binary
*.jpg   binary
*.ico   binary
*.pfx   binary
*.dll   binary
*.exe   binary
*.msi   binary
*.nupkg binary

# Vendored web fonts — binary even though text=auto's NUL sniffing already
# happens to catch them; explicit declaration keeps future files safe.
*.woff  binary
*.woff2 binary
*.ttf   binary
